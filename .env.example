# Get API_ID / API_HASH from https://my.telegram.org/apps
# Pyrogram needs these even for a bot account — they're what let it talk
# to Telegram's MTProto layer directly instead of the HTTP Bot API, which
# is what removes the 50MB upload limit.
API_ID=
API_HASH=

# From @BotFather
BOT_TOKEN=

# Your numeric Telegram user ID. If set, only this ID (and anyone you
# /allow) can use the bot. Leave blank to let anyone use it.
ADMIN_ID=

# Optional: Google Drive as a secondary/alternate destination.
# SINGLE account (backwards compatible):
GCP_CLIENT_ID=
GCP_CLIENT_SECRET=
GCP_REFRESH_TOKEN=
# MULTIPLE accounts — repeat blocks like this (name after GDrive_ is free):
#   GDrive_work_CLIENT_ID=...
#   GDrive_work_CLIENT_SECRET=...
#   GDrive_work_REFRESH_TOKEN=...
# Users then pick the account per chat in /settings → ☁️ Drive account.
#
# Optional: pin all uploads inside one folder ID (applies to every account).
DRIVE_FOLDER_ID=

# Folder name on Drive where settings.json + IG indexes are stored.
# Defaults to "AzBotData".
DATA_DRIVE_FOLDER=AzBotData

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to
# INFO. Logs go to both the console and data/logs/bot.log (rotated at 10MB,
# 3 backups kept).
LOG_LEVEL=INFO

# Optional: raw yt-dlp option overrides as a JSON object, merged on top of
# the bot's defaults. Same idea as WZML-X's YT_DLP_OPTIONS — lets you tweak
# yt-dlp behavior without touching code, e.g.:
# YT_DLP_OPTIONS={"writesubtitles": true, "subtitleslangs": ["en"]}
YT_DLP_OPTIONS=

# Optional: parallel MTProto media sessions for big uploads (bot-token-only).
# 1 = stock pyrogram behavior. Defaults 4 × 24-part window ≈ 12MB of
# in-flight buffers — the throughput lever with negligible RAM cost (the
# restarts came from Drive chunk buffers + ungated ffmpeg, both gated now).
# The BIGGEST Telegram speed factor is actually your api_id: public/shared
# api_ids get throttled hard by Telegram — create your own at
# my.telegram.org (free) and put it in .env (API_ID/API_HASH).
UPLOAD_SESSIONS=
# Optional: max unacknowledged 512KB parts in flight across all sessions.
UPLOAD_WINDOW=

# Optional: handler thread-pool size (default 16). Raise only if you share
# the bot among many chats and hit slowdowns during simultaneous probes.
HANDLER_WORKERS=

# Optional: concurrent download/upload JOBS (default 2, was hardcoded 4).
# Each active job runs its own subprocess (yt-dlp/aria2c/gallery-dl/ffmpeg)
# plus MTProto transfer buffers — on a low-RAM host this is the biggest
# peak-memory lever after UPLOAD_WORKERS. 2 keeps the queue responsive
# while halving worst-case concurrent load.
QUEUE_WORKERS=

# Optional: how many files upload concurrently per job (default 1 — the
# stable profile; 2 was reverted after an OOM restart on the low-RAM host
# during archiving). Each concurrent upload is another file's worth of
# transfer buffers plus its own ffmpeg/ffprobe subprocess calls — on a
# memory-constrained host this is a direct multiplier on PEAK memory, which
# is what actually triggers an out-of-memory kill. Raise only if your host
# has RAM headroom. Each file is still deleted the moment ITS upload
# finishes, regardless of concurrency.
UPLOAD_WORKERS=

# Optional: concurrent DRIVE uploads (default 1 = strictly serial, the
# safe profile). 2 doubles Drive-mirror throughput but re-enables the
# concurrent httplib2 resumable uploads that once corrupted the heap on
# this stack — set only if you accept that risk.
DRIVE_UPLOAD_CONCURRENCY=

# Optional: set to 1 to install Rclone for multi-cloud mirrors (Mega,
# OneDrive, Dropbox, S3, WebDAV…) via /rclone. Set to 0 or leave blank
# to skip and save ~60–100 MB of disk space.
INSTALL_RCLONE=

# ── Public links (/px) ──────────────────────────────────────────────────
# Reply to a file with /px and the bot uploads it to pixeldrain and replies
# with a shareable link plus a direct download URL. Cuts past Telegram's
# per-file limits and gives scripts/other bots something to fetch.
#
# One or more pixeldrain API keys (https://pixeldrain.com/user/api_keys),
# comma or newline separated. The bot tries them in order, remembers the one
# that worked, and skips an account that reports "out of space" for
# PIXELDRAIN_COOLDOWN_H hours before trying it again. A revoked key is
# dropped for good. PIXELDRAIN_API_KEY (singular) also works.
# Errors surfaced to the user: user_out_of_space / too_many_files /
# email_address_not_verified → rotate; authentication_required /
# account_banned → key dropped; file_too_large (>10 GB) and
# ip_rate_limit_reached (429) → hard error, rotation cannot help;
# writing / internal (5xx) → pixeldrain-side problem, reported as-is.
PIXELDRAIN_API_KEYS=
# Hours a full account is skipped before being retried. Default 6.
PIXELDRAIN_COOLDOWN_H=6
# 1 = when no pixeldrain key can take the file, upload to x0.at instead
# (keyless, 1 GiB max, links live 3-100 days). 0 = fail with an error.
PIXELDRAIN_FALLBACK=1

# ── upload.am (/ua) ─────────────────────────────────────────────────────
# /ua <direct url> makes upload.am fetch the file on ITS servers and store it
# in your account. Nothing is downloaded to this bot's disk, which is what
# makes large files workable on a small VPS.
# Tokens: upload.am → Account → API. One or more, comma or newline separated.
# Free plan = 25 GB storage, 5 GB/file, files kept 30 days after the last
# download. When one account is full or rate-limited the next is used; a
# revoked token is dropped for good. UA_TOKEN (singular) also works.
# Errors surfaced to the user: invalid_token / expired_token /
# account_disabled → that token is dropped; quota_exceeded / file_too_large /
# email_not_verified / rate_limited → rotate to the next token; unsafe_url →
# the URL points at a private address and is refused (no rotation);
# network → reported as-is.
UA_TOKENS=
# Optional: put fetched files in this folder (uuid from the cabinet URL).
# Blank = account root.
UA_FOLDER_UUID=
# Minutes /ua waits for the fetch to appear before giving up (default 20).
UA_POLL_MIN=20
# Hours a quota-full / rate-limited token is skipped before being retried.
UA_COOLDOWN_H=6

# ── Instagram DM downloads (/directdownload) ─────────────────────────────
# Users DM links to this bot's Instagram Professional account and the files
# arrive in Telegram. Only Meta's official Instagram Messaging API can read
# DMs — no password is ever asked for or stored.
#
# Setup (all of it is on Meta's side, not in this file):
#   1. Instagram account must be Professional (Business/Creator) and linked
#      to a Facebook Page.
#   2. Create a Meta app → add the Instagram product → permissions
#      instagram_basic, instagram_manage_messages, pages_manage_metadata.
#   3. App Review for instagram_manage_messages (needed for anyone who is not
#      an app admin/tester). Your own accounts work without review.
#   4. Public HTTPS in front of IG_WEBHOOK_PORT (Caddy/nginx/Cloudflare
#      Tunnel). Meta refuses self-signed certs. Callback URL:
#        https://your-domain/ig/webhook
#      Verify token: whatever you put in IG_VERIFY_TOKEN.
#   5. Subscribe the app to the Instagram `messages` (and `messaging_postbacks`)
#      webhook fields.
#
# Which Meta setup the token comes from. The two are NOT interchangeable:
#   https://graph.instagram.com  → "Instagram API with Instagram Login".
#       Token = Instagram User access token. No Facebook Page needed. Simpler,
#       and the recommended starting point.
#   https://graph.facebook.com   → "Instagram API with Facebook Login".
#       Token = Page access token, and the Instagram account must be linked to
#       a Facebook Page.
IG_API_HOST=https://graph.instagram.com
# Graph API version. Meta retires versions after ~2 years — bump this if you
# start getting version-deprecation errors.
IG_API_VERSION=v23.0
# App secret — verifies every webhook payload's X-Hub-Signature-256.
IG_APP_SECRET=
# Access token: Instagram User token (Instagram Login) or Page token
# (Facebook Login), depending on IG_API_HOST above.
IG_PAGE_TOKEN=
# Instagram Professional account ID — numeric, starts 178414…, NOT the @handle.
IG_ACCOUNT_ID=
# Your own random string; must match what you type in the App Dashboard.
IG_VERIFY_TOKEN=
# Port for the built-in stdlib webhook listener. 0/blank = feature off.
IG_WEBHOOK_PORT=0
# Path Meta POSTs to. Must match the App Dashboard callback URL path.
IG_WEBHOOK_PATH=/ig/webhook
